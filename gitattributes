# Normaliza os finais de linha de todo o repositório para LF,
# independente do sistema operacional de quem commita.
* text=auto eol=lf

# Garante LF explicitamente nos tipos de arquivo do projeto
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Arquivos binários (não devem ser convertidos)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.svg  binary
*.ico  binary
